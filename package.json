    "content:worksheet": "tsx scripts/generate-worksheet.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.1.1",
    "@fontsource-variable/fraunces": "^5.1.1",
